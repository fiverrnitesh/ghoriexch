# Database
DATABASE_URL="postgresql://games:games_dev@localhost:5432/games_platform?schema=public"

# API
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=games_session

# Development wallet sandbox (NEVER enable in production)
WALLET_SANDBOX_MODE=true
WALLET_SANDBOX_MAX_CREDIT=100000

# Admin test mode — development only (NEVER enable in production)
ADMIN_TEST_MODE=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend URLs
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001

# Admin
VITE_ADMIN_API_URL=http://localhost:3001
